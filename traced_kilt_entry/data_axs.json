{
    "better_units_query": [ "python_package", "package_name=pint", ["desired_python_version", ["^", "kernel_python_major_dot_minor"]] ],
    "pretty_print_table_query": [ "python_package", "package_name=tabulate", ["desired_python_version", ["^", "kernel_python_major_dot_minor"]] ],
    "numpy_query": [ "python_package", "package_name=numpy", ["desired_python_version", ["^", "kernel_python_major_dot_minor"]] ],
    "_BEFORE_CODE_LOADING": [ "^^", "execute", [[
        [ "get_kernel" ],
        [ "byquery", [[ "^^", "get", "better_units_query" ]] ],
        [ "use" ],
        [],
        [ "get_kernel" ],
        [ "byquery", [[ "^^", "get", "pretty_print_table_query" ]] ],
        [ "use" ],
        [],
        [ "get_kernel" ],
        [ "byquery", [[ "^^", "get", "numpy_query" ]] ],
        [ "use" ],
        []
    ]] ],
    "rel_trace_path": "kilt.trace",
    "rel_pftrace_path": "output.pftrace",
    
    "abs_dir": [ "^^", "get_path" ],
    "abs_trace_path": [ "^^", "get_path", [ [ "^^", "get", "rel_trace_path" ] ] ],
    "abs_pftrace_path": [ "^^", "get_path", [ [ "^^", "get", "rel_pftrace_path" ] ] ],

    "filter_start": "0m",
    "filter_end": "1000m",

    "pftrace": [ "^^", "execute", [[
        [ "get_kernel" ],
        [ "byquery", "compiled,trace_converter" ],
        [ "run", [], { 
            "input_file": [ "^^", "get", "abs_trace_path" ],
            "output_file": [ "^^", "get", "abs_pftrace_path" ],
            "filter_start": [ "^^", "get", "filter_start" ],
            "filter_end": [ "^^", "get", "filter_end" ]
        }],
        [],
        [ "get", "abs_pftrace_path" ]
    ]] ]
}
